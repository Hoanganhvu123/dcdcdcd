PORT=8060
WRAPPER_PORT=8788

# ====================== DATABASE ======================
CONV_DATABASE_URL=postgresql://user:password@localhost:5432/postgres
CHECKPOINT_POSTGRES_SCHEMA=ai_data_analytics
USE_REDIS=false

# ====================== LANGFUSE ======================
LANGFUSE_SECRET_KEY="sk-lf-your-secret-key-here"
LANGFUSE_PUBLIC_KEY="pk-lf-your-public-key-here"
LANGFUSE_HOST="https://cloud.langfuse.com"

# ====================== LLM APIS ======================
DEEPSEEK_API_KEY=your-deepseek-api-key
GEMINI_API_KEY=your-gemini-api-key
GOOGLE_API_KEY=your-google-api-key
GEMINI_MODEL_MODE=gemini-2.5-flash
DEFAULT_MODEL=auto

# ====================== FIRECRAWL ======================
FIRECRAWL_API_KEY=your-firecrawl-key
FIRECRAWL_API_URL=http://localhost:3002

# ====================== UPSTASH REDIS CLOUD ======================
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Debug Mode
DEBUG=true
ENVIRONMENT=development

# ====================== LANGSMITH ======================
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your-langchain-api-key
LANGSMITH_API_KEY=your-langsmith-api-key
LANGCHAIN_PROJECT=ai_data_analytics

# OpenRouter (DeepSeek V4 Flash via OpenRouter + Qwen Free)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_PROVIDER_ORDER=auto
OPENROUTER_FREE_MODEL=qwen/qwen3.8-27b:free
