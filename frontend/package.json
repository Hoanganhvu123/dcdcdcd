  "scripts": {
    "start": "vite preview",
    "dev": "vite",
    "build": "vite build",
    "build:prod": "vite build --mode prod",
    "lint": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write '**/*.{ts,tsx}'",
    "test:datasource": "node tests/use-openwork-datasource.check.mjs && npx tsx tests/use-openwork-datasource.ts.check.ts && node tests/m5-datasource-simulation.check.mjs && node tests/m5-multi-round-analysis.check.mjs",
    "test:simulation": "node tests/m5-datasource-simulation.check.mjs && node tests/m5-multi-round-analysis.check.mjs",
    "test:replay": "node scripts/run-replay-tests.mjs",
    "test:control": "node tests/run-control-tests.mjs",
    "test:theme": "node tests/theme-tokens.check.mjs",
    "test:hooks": "npx tsx hooks/use-analyst-chat.check.ts && npx tsx hooks/use-analyst-chat.async.check.ts && npx tsx hooks/use-analyst-chat.adversarial.check.ts && npx tsx shims/next-router.check.ts && npx tsx shims/next-router.challenger.check.ts && npx tsx tests/m3-architecture.check.ts && npx tsx tests/m2-primitives-icons.check.ts && npx tsx tests/use-openwork-datasource.ts.check.ts && npx tsx tests/m2-conversation-hydration-skills.check.ts",
    "test:e2e": "playwright test --config=../playwright.config.ts",
    "test": "node tests/theme-tokens.check.mjs && node tests/use-openwork-history.check.mjs && npx tsx tests/m1-slash-commands.check.ts && npx tsx tests/m1-universal-flow-dag.check.ts && npx tsx tests/m2-conversation-hydration-skills.check.ts && npx tsx tests/m2-artifact-workbench-dynamic.check.ts && npx tsx tests/m2-revenue-engine-charts.check.ts && node tests/use-openwork-datasource.check.mjs && npx tsx tests/use-openwork-datasource.ts.check.ts && node tests/m5-datasource-simulation.check.mjs && node tests/m5-multi-round-analysis.check.mjs",
    "test:business-workflows": "npx tsx tests/run-all-business-workflow-tests.ts",
    "test:all": "npm run test:theme && npm run test:hooks && npm run test:replay && npm run test:control && npm run test:simulation",
    "preview": "vite preview"
  },
